{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leaf-api",
  "main": "src/index.ts",
  "dev": {
    "port": 8000,
  },
  "compatibility_date": "2026-02-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 1000,
        "period": 60,
      },
    },
  ],
}
